# Copy to terraform.tfvars and edit locally. Do not commit terraform.tfvars.

# Authentication: prefer `export RUNPOD_API_KEY=...` instead of setting this.
# runpod_api_key = ""

name_prefix = "strg"

# Cost guardrail: keep at 0 unless actively training/evaluating.
pod_count = 0

# For an active training pod, set:
# pod_count = 1

gpu_type_ids = [
  # Low-cost research default using RunPod API enum names.
  # Starts with available 48GB GPUs, then cheaper 24GB fallbacks.
  "NVIDIA A40",
  "NVIDIA RTX A6000",
  "NVIDIA GeForce RTX 3090",
  "NVIDIA RTX A5000",
  "NVIDIA GeForce RTX 4090",
  "NVIDIA RTX 6000 Ada Generation",

  # Premium 80GB GPUs are intentionally excluded from the low-cost default.
  # Add manually only when needed:
  # "NVIDIA A100-SXM4-80GB",
  # "NVIDIA H100 80GB HBM3",
]

gpu_count = 1

# Highest scheduling success mode:
# - false: do not attach the network volume; lets RunPod choose any data center.
# - true: attach the persistent network volume; pods must run in data_center_id.
attach_network_volume = false

# On-demand capacity is more likely to schedule than interruptible/spot.
interruptible = false

# Network volumes must live in the same RunPod data center as attached pods.
# Used when attach_network_volume = true.
data_center_id  = "US-CA-2"
data_center_ids = []

image_name             = "runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04"
network_volume_size_gb = 100
pod_volume_size_gb     = 20
container_disk_in_gb   = 20

ports = [
  "22/tcp",
  "8888/http",
  "6006/http",
]

env = {
  STRG_ENV = "research"
}
