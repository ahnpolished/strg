# ── Example terraform.tfvars ─────────────────────────────────────────
# Copy to terraform.tfvars and adjust before applying.
# terraform.tfvars is gitignored — DO NOT commit secrets here.

project    = "ahnpolished"
region     = "us-central1"

# Serving
serve_name      = "strg-serve"
serve_image_tag = "latest"
load_in_4bit    = true

# Storage
weights_bucket_name     = ""   # auto-generate from project name
weights_bucket_location = "US-CENTRAL1"

# Artifact Registry
docker_repo_name = "strg-serve"

# Budget (alerts only — does not stop spend)
budget_amount  = 10
budget_email   = "stahn1995@gmail.com"

# GitHub Actions CI/CD (WIF)
github_repo = "myorg/strg"   # <-- change to your actual repo

# Fine-tune (disabled by default)
finetune_instance_count = 0
